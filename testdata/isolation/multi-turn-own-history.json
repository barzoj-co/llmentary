{
  "id": "multi-turn-own-history",
  "description": "X adds two new user messages on call 2. Y independently sends X's earlier (non-last) second message. That text is introduced by X, so not a leak. Last-only clients fail this.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-x",
    "calls": [
      {
        "id": "call_x1",
        "session_id": "sess-x",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "First turn from X itself"}
          ]
        }
      },
      {
        "id": "call_x2",
        "session_id": "sess-x",
        "seq": 2,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "First turn from X itself"},
            {"role": "assistant", "content": "Noted."},
            {"role": "user", "content": "Second turn from X itself"},
            {"role": "user", "content": "Third turn from X itself"}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-y",
    "calls": [
      {
        "id": "call_y1",
        "session_id": "sess-y",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Second turn from X itself"}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": true,
    "message_contains": []
  }
}
