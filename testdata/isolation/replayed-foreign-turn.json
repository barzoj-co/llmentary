{
  "id": "replayed-foreign-turn",
  "description": "X first-call inbound history is Y's turn (seen, not introduced). A later X call still contains that history. Must fail as a leak. Own later messages are not the issue.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-x",
    "calls": [
      {
        "id": "call_x1",
        "session_id": "sess-x",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Secret thread from the other app"},
            {"role": "assistant", "content": "I need more data."},
            {"role": "user", "content": "Continue from the saved thread."}
          ]
        }
      },
      {
        "id": "call_x2",
        "session_id": "sess-x",
        "seq": 2,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Secret thread from the other app"},
            {"role": "assistant", "content": "I need more data."},
            {"role": "user", "content": "Continue from the saved thread."},
            {"role": "user", "content": "And one more question from X"}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-y",
    "calls": [
      {
        "id": "call_y1",
        "session_id": "sess-y",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Secret thread from the other app"}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": false,
    "message_contains": [
      "user text 'Secret thread from the other app'",
      "also introduced by session sess-y #1 (call_y1)",
      "appears in session sess-x #1 (call_x1)"
    ]
  }
}
