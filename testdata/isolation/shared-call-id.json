{
  "id": "shared-call-id",
  "description": "The same call id in both sessions fails rule 2.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-x",
    "calls": [
      {
        "id": "call_shared",
        "session_id": "sess-x",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Weather in Paris?"}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-y",
    "calls": [
      {
        "id": "call_shared",
        "session_id": "sess-y",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Weather in Berlin?"}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": false,
    "message_contains": [
      "call id",
      "call_shared"
    ]
  }
}
