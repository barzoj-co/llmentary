{
  "id": "first-call-history-repeat",
  "description": "First-call inbound history is seen, not introduced. Repeating that history on a later X call is still a leak from Y.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-x",
    "calls": [
      {
        "id": "call_x1",
        "session_id": "sess-x",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Where is my order?"},
            {"role": "assistant", "content": "I need more data."},
            {"role": "user", "content": "Continue from the saved thread."}
          ]
        }
      },
      {
        "id": "call_x2",
        "session_id": "sess-x",
        "seq": 2,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Where is my order?"}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-y",
    "calls": [
      {
        "id": "call_y1",
        "session_id": "sess-y",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Where is my order?"}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": false,
    "message_contains": [
      "user text 'Where is my order?'",
      "also introduced by session sess-y #1 (call_y1)",
      "appears in session sess-x #1 (call_x1)"
    ]
  }
}
