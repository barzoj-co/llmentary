{
  "id": "shared-text-uninvolved",
  "description": "C replays A's canned question. B sent the same text independently and never touched A's thread. C.isolated_from(B) still fails — rule 3 is text-only.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-c",
    "calls": [
      {
        "id": "call_c1",
        "session_id": "sess-c",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Where is my order?"},
            {"role": "assistant", "content": "I need more data."},
            {"role": "user", "content": "Continue from the saved thread."}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-b",
    "calls": [
      {
        "id": "call_b1",
        "session_id": "sess-b",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "messages": [
            {"role": "user", "content": "Where is my order?"}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": false,
    "message_contains": [
      "user text 'Where is my order?'",
      "also introduced by session sess-b #1 (call_b1)",
      "appears in session sess-c #1 (call_c1)"
    ]
  }
}
