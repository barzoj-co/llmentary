{
  "id": "responses-history-replay",
  "description": "Responses input array: X replays Y's user turn as history.",
  "allow_empty": false,
  "min_chars": 8,
  "ignore_texts": [],
  "x": {
    "id": "sess-x",
    "calls": [
      {
        "id": "call_x1",
        "session_id": "sess-x",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "input": [
            {"role": "user", "content": [{"type": "input_text", "text": "What is my biological age?"}]},
            {"role": "assistant", "content": [{"type": "output_text", "text": "I need more data."}]},
            {"role": "user", "content": [{"type": "input_text", "text": "Continue from the saved thread."}]}
          ]
        }
      }
    ]
  },
  "y": {
    "id": "sess-y",
    "calls": [
      {
        "id": "call_y1",
        "session_id": "sess-y",
        "seq": 1,
        "raw_request": {
          "model": "gpt-4.1-nano",
          "input": [
            {"role": "user", "content": [{"type": "input_text", "text": "What is my biological age?"}]}
          ]
        }
      }
    ]
  },
  "expect": {
    "isolated": false,
    "message_contains": [
      "user text 'What is my biological age?'",
      "from session sess-y #1 (call_y1)",
      "appears in session sess-x #1 (call_x1)"
    ]
  }
}
